      },
      "title": "Columns",
      "type": "array"
    },
    "dropped_rows": {
      "$ref": "#/$defs/DroppedRows",
      "default": {
        "blank_rows": 0,
        "note_rows": 0,
        "source_indices": {},
        "summary_rows": 0,
        "total_rows": 0
      }
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "source_details": {
      "additionalProperties": true,
      "default": {},
      "title": "Source Details",
      "type": "object"
    },
    "source_file": {
      "title": "Source File",
      "type": "string"
    },
    "source_part": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Part"
    }
