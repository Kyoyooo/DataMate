          "type": "object"
        },
        "summary_rows": {
          "default": 0,
          "title": "Summary Rows",
          "type": "integer"
        },
        "total_rows": {
          "default": 0,
          "title": "Total Rows",
          "type": "integer"
        }
      },
      "title": "DroppedRows",
      "type": "object"
