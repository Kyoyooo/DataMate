{
  "$defs": {
    "JoinEdge": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "enum": [
            "n:1",
            "1:1",
            "n:n"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "left": {
          "title": "Left",
          "type": "string"
        },
        "match_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Rate",
          "type": "number"
        },
        "right": {
          "title": "Right",
          "type": "string"
        }
      },
      "required": [
        "left",
        "right",
        "cardinality",
        "match_rate"
      ],
      "title": "JoinEdge",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One model call, captured exactly (SPEC §5.7). Errors are values, never raised.",
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "finish_reason": {
          "title": "Finish Reason",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "stage": {
          "enum": [
            "parse",
            "solve",
            "repair",
            "compile",
            "rule_profile"
          ],
          "title": "Stage",
          "type": "string"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "stage",
        "template_id",
        "backend",
        "request_sha256",
        "params",
        "content",
        "reasoning",
        "finish_reason",
        "latency_ms"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "TableRole": {
      "additionalProperties": false,
      "properties": {
        "grain": {
          "title": "Grain",
          "type": "string"
        },
        "role": {
          "enum": [
            "fact",
            "dimension",
            "lookup",
            "log",
            "other"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "grain"
      ],
      "title": "TableRole",
      "type": "object"
    },
    "ValueSemantic": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "column",
        "value",
        "meaning"
      ],
      "title": "ValueSemantic",
      "type": "object"
    },
    "ViewCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "ViewCheck",
      "type": "object"
    },
    "ViewSpec": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "other",
          "title": "Category",
          "type": "string"
        },
        "ddl": {
          "title": "Ddl",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "exclusion_check": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Check"
        },
        "key_columns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Key Columns",
          "type": "array"
        },
        "name": {
          "pattern": "^v_[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ViewValidation",
          "default": {
            "checks": [],
            "executed": false,
            "row_count": 0
          }
        }
      },
      "required": [
        "name",
        "purpose",
        "ddl"
      ],
      "title": "ViewSpec",
      "type": "object"
    },
    "ViewValidation": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ViewCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "executed": {
          "default": false,
          "title": "Executed",
          "type": "boolean"
        },
        "row_count": {
          "default": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "title": "ViewValidation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compile_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelCall"
      },
      "title": "Compile Calls",
      "type": "array"
    },
    "join_paths": {
      "default": [],
      "items": {
        "$ref": "#/$defs/JoinEdge"
      },
      "title": "Join Paths",
      "type": "array"
    },
    "table_roles": {
      "additionalProperties": {
        "$ref": "#/$defs/TableRole"
      },
      "default": {},
      "title": "Table Roles",
      "type": "object"
    },
    "value_semantics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ValueSemantic"
      },
      "title": "Value Semantics",
      "type": "array"
    },
    "views": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ViewSpec"
      },
      "maxItems": 8,
      "title": "Views",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "SemanticAnnotations",
  "type": "object"
}
